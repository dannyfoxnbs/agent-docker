#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: ./compose/run [--build] <claude|codex|pi> [workspace]

Examples:
  ./compose/run claude ../my-project
  ./compose/run pi ../my-project
  ./compose/run --build codex ../my-project
EOF
}

build=false
if [ "${1:-}" = "--build" ]; then
  build=true
  shift
fi

agent=${1:-}
case "$agent" in
  claude|codex|pi) ;;
  *) usage >&2; exit 2 ;;
esac
shift

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
env_file=${AGENT_ENV_FILE:-$repo_root/.env}

# First run gets a .env of its own, so the file to edit exists and is named in
# the notice below rather than being something the reader has to go and find.
if [ ! -f "$env_file" ] && [ -f "$repo_root/env.example" ]; then
  cp "$repo_root/env.example" "$env_file"
  printf 'Created %s from env.example. Edit it to set defaults.\n' "$env_file" >&2
fi

if [ -f "$env_file" ]; then
  set -a
  . "$env_file"
  set +a
fi

workspace=${1:-${WORKSPACE:-$repo_root}}
if [ ! -d "$workspace" ]; then
  printf 'Workspace does not exist: %s\n' "$workspace" >&2
  exit 1
fi
workspace=$(CDPATH= cd -- "$workspace" && pwd -P)

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
  printf '%s\n' 'Docker with the Compose plugin is required.' >&2
  exit 1
fi

compose_file="$repo_root/compose/compose.yaml"
set -- -f "$compose_file"
if [ -f "$env_file" ]; then
  set -- --env-file "$env_file" "$@"
fi
if [ -d /mnt/wslg ] && [ -d /tmp/.X11-unix ]; then
  set -- "$@" -f "$repo_root/compose/compose.wslg.yaml"
fi

# Said before Docker does anything, because the failure it prevents otherwise
# turns up much later, inside a skill, as an authentication error.
if [ -z "${AZURE_DEVOPS_EXT_PAT:-}" ]; then
  printf '%s\n' \
    'No Azure DevOps PAT set. The *-azure-devops-* skills will fail until you set' \
    "AZURE_DEVOPS_EXT_PAT in $env_file. Nothing else is affected." >&2
fi

# The image is built once and reused, so anything that changes what the image
# should contain has to trigger a rebuild by itself. A hash of the build inputs
# is stamped on the image as a label, because a fully cached rebuild does not
# refresh the image's creation time and would otherwise nag on every run.
hash_build_inputs() {
  cat "$repo_root/compose/Dockerfile" "$repo_root/compose/entrypoint.sh" 2>/dev/null \
    | { sha256sum 2>/dev/null || shasum -a 256; } \
    | awk '{print $1}'
}

image_label() {
  docker image inspect --format "{{index .Config.Labels \"$1\"}}" \
    portable-agents:local 2>/dev/null
}

image_needs_build() {
  if ! docker image inspect portable-agents:local >/dev/null 2>&1; then
    printf '%s\n' 'Building the agent image. This happens once.' >&2
    return 0
  fi

  want_azure_cli=${INSTALL_AZURE_CLI:-false}
  have_azure_cli=$(image_label com.portable-agents.azure-cli)
  if [ "$want_azure_cli" != "$have_azure_cli" ]; then
    printf 'Rebuilding: INSTALL_AZURE_CLI is %s, the image was built with %s.\n' \
      "$want_azure_cli" "${have_azure_cli:-an older image without the label}" >&2
    return 0
  fi

  if [ -n "$BUILD_INPUTS_SHA" ] && [ "$BUILD_INPUTS_SHA" != "$(image_label com.portable-agents.inputs)" ]; then
    printf '%s\n' 'Rebuilding: the Dockerfile or entrypoint changed.' >&2
    return 0
  fi

  return 1
}

BUILD_INPUTS_SHA=$(hash_build_inputs)
export BUILD_INPUTS_SHA

if [ "$build" = true ]; then
  WORKSPACE="$workspace" docker compose "$@" build --pull --no-cache
elif image_needs_build; then
  WORKSPACE="$workspace" docker compose "$@" build --pull
fi

exec env WORKSPACE="$workspace" docker compose "$@" run --rm "$agent"
