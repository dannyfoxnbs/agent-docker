{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-lint-changed-file.mjs\"",
            "timeout": 60,
            "statusMessage": "lint:agent: checking changed lines…"
          }
        ]
      }
    ]
  }
}
