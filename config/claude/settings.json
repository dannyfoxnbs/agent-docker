{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Bash(. *.env*)",
      "Bash(awk *.env*)",
      "Bash(cat *.env*)",
      "Bash(grep *.env*)",
      "Bash(head *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(nl *.env*)",
      "Bash(od *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(source *.env*)",
      "Bash(strings *.env*)",
      "Bash(tail *.env*)",
      "Bash(xxd *.env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(.env)",
      "Read(.env.*)"
    ],
    "ask": ["Bash(git push:*)"]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/update-status.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/nx-guard.sh",
            "timeout": 600,
            "statusMessage": "nx-guard: affected lint/build/test…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/danny/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/update-status.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "diff-review",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/diff-review-hook.mjs",
            "timeout": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/update-status.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "breezeai-plugins": {
      "source": {
        "source": "github",
        "repo": "accionlabs/breezeai-hubexo-plugin"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
