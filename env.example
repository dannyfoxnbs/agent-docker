# Copy this file to .env in the repository root and edit it: cp env.example .env
# .env is git-ignored. This template is named without the leading dot so that
# agent permission rules denying access to .env files do not also cover it.
#
# Both ./compose/run and ./sbx/run read .env, and ./compose/run also passes it
# to docker compose as --env-file so plain `docker compose` picks up the same
# values. A workspace path given on the command line always wins over WORKSPACE.

# Default project mounted at /workspace when no workspace argument is given.
# Use an absolute path or ~; a relative path resolves against your current
# directory, not this repository.
#WORKSPACE=~/repos/nimbus

# Location of the agent-eslint-rules clone bind-mounted at /opt/agent-eslint-rules.
# This one is a docker compose bind source, so a relative path resolves against
# the compose/ directory. Point it at another clone to use different thresholds.
#AGENT_ESLINT_RULES=../agent-eslint-rules
